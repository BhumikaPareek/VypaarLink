# =============================================================================
# Vyapar Link — Backend Environment Variables Template
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the same directory:
#       cp .env.example .env
# 2. Fill in the values for your local setup.
# 3. NEVER commit the actual '.env' file to Git.
#    It is already added to .gitignore.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=localhost

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string format:
#   postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
#
# Replace with your actual PostgreSQL credentials:
#   USERNAME = your PostgreSQL user (usually 'postgres' for local dev)
#   PASSWORD = the password you set during PostgreSQL installation
#   DATABASE_NAME = create a new database named 'vyapar_link'
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/vyapar_link"

# ── Authentication ────────────────────────────────────────────────────────────
# JWT secret — must be at least 32 characters, random, and kept secret.
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of the frontend dev server (Vite default)
CORS_ORIGIN=http://localhost:5173
