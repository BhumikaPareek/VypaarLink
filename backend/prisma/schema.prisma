// =============================================================================
// Vyapar Link — Prisma Schema
// Database: PostgreSQL
// =============================================================================
//
// Design principles:
// - All tables use UUID primary keys (more secure than auto-increment integers)
// - Timestamps on every table (createdAt, updatedAt) for audit trail
// - Soft-delete pattern (deletedAt) where data must be preserved for ledger integrity
// - Enum types defined in DB for role and status fields
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum UserRole {
  SHOPKEEPER
  CUSTOMER
  PLATFORM_ADMIN
}

enum TransactionType {
  CREDIT  // Shopkeeper gave goods/services on credit
  PAYMENT // Customer made a payment
}

enum TransactionStatus {
  PENDING   // Recorded by one party, not yet confirmed
  CONFIRMED // Confirmed by both parties
  FLAGGED   // Customer has raised a concern / dispute
}

// ── Users ──────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  isClaimed    Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A shopkeeper owns a shop; a customer connects to shops
  shop              Shop?          @relation("ShopOwner")
  shopConnections   ShopCustomer[] @relation("CustomerConnections")

  // Transactions recorded by this user (shopkeeper records credit/payment)
  recordedTransactions Transaction[] @relation("RecordedBy")

  @@map("users")
}

// ── Phone Verification (OTP) ───────────────────────────────────────────────────

model PhoneVerification {
  id         String   @id @default(uuid())
  phone      String   @unique
  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  verified   Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("phone_verifications")
}

// ── Shops ──────────────────────────────────────────────────────────────────────

model Shop {
  id          String  @id @default(uuid())
  name        String
  description String?
  address     String?
  phone       String?
  isActive    Boolean @default(true)

  ownerId     String  @unique
  owner       User    @relation("ShopOwner", fields: [ownerId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Customers connected to this shop
  customers    ShopCustomer[]
  // All transactions for this shop
  transactions Transaction[]
  // Inventory products for this shop
  products        Product[]
  // Suppliers for this shop
  suppliers       Supplier[]
  // Purchase orders for this shop
  purchaseOrders  PurchaseOrder[]
  // Supplier payments for this shop
  supplierPayments SupplierPayment[]

  @@map("shops")
}

// ── Shop-Customer Relationship (Join Table) ────────────────────────────────────
// A customer can be connected to multiple shops.
// A shop can have multiple customers.
// This join table tracks the relationship and when it was established.

model ShopCustomer {
  id         String   @id @default(uuid())
  shopId     String
  customerId String
  isActive   Boolean  @default(true)  // False = customer disconnected from shop
  joinedAt   DateTime @default(now())

  shop       Shop  @relation(fields: [shopId], references: [id])
  customer   User  @relation("CustomerConnections", fields: [customerId], references: [id])

  // Ensure a customer is only connected to the same shop once
  @@unique([shopId, customerId])
  @@map("shop_customers")
}

// ── Transactions ───────────────────────────────────────────────────────────────
// A transaction is either a CREDIT (shopkeeper gave goods on credit)
// or a PAYMENT (customer paid back some amount).
//
// Key design: status field enables mutual confirmation.
// When shopkeeper records a transaction, status = PENDING.
// When customer confirms, status = CONFIRMED.
// If customer disagrees, status = FLAGGED (for clarification).

model Transaction {
  id          String            @id @default(uuid())
  shopId      String
  customerId  String
  amount      Decimal           @db.Decimal(10, 2)  // Up to 99,999,999.99
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  note        String?           // Shopkeeper's note (e.g. "Rice + Oil")
  recordedById String

  // Mutual confirmation fields
  confirmedAt  DateTime?   // When customer confirmed
  flaggedAt    DateTime?   // When customer flagged
  flagReason   String?     // Customer's reason for flagging

  // Additional transaction details
  transactionDate DateTime @default(now())
  dueDate         DateTime?
  paymentMethod   String?
  reference       String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?  // Soft delete — transactions must never be hard-deleted

  shop         Shop @relation(fields: [shopId], references: [id])
  recordedBy   User @relation("RecordedBy", fields: [recordedById], references: [id])

  // Index for fast lookup of a customer's transactions at a shop
  @@index([shopId, customerId])
  @@index([customerId])
  @@map("transactions")
}

// ── Inventory Enums ────────────────────────────────────────────────────────────

enum StockMovementType {
  OPENING_STOCK
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  SALE
}

// ── Products ───────────────────────────────────────────────────────────────────

model Product {
  id                String  @id @default(uuid())
  shopId            String
  name              String
  sku               String?
  category          String?
  price             Decimal @db.Decimal(10, 2)
  quantity          Int     @default(0)
  unit              String  @default("pcs")
  lowStockThreshold Int     @default(5)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop            @relation(fields: [shopId], references: [id])
  movements StockMovement[]
  orderItems PurchaseOrderItem[]
  receivedItems GoodsReceiptItem[]

  @@index([shopId])
  @@index([shopId, isActive])
  @@map("products")
}

// ── Stock Movements ────────────────────────────────────────────────────────────

model StockMovement {
  id        String            @id @default(uuid())
  productId String
  shopId    String
  type      StockMovementType
  quantity  Int
  note      String?
  createdAt DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([shopId])
  @@map("stock_movements")
}

// ── Supplier Workflow Enums ───────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  PLACED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierPaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

// ── Suppliers ─────────────────────────────────────────────────────────────────

model Supplier {
  id            String   @id @default(uuid())
  shopId        String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstin         String?
  notes         String?
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id])
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([shopId])
  @@index([shopId, isActive])
  @@map("suppliers")
}

// ── Purchase Orders ───────────────────────────────────────────────────────────

model PurchaseOrder {
  id             String              @id @default(uuid())
  shopId         String
  supplierId     String
  orderNumber    String
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  status         PurchaseOrderStatus @default(DRAFT)
  totalAmount    Decimal             @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal             @default(0) @db.Decimal(10, 2)
  notes          String?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  shop           Shop                @relation(fields: [shopId], references: [id])
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  receipts       GoodsReceipt[]
  payments       SupplierPayment[]

  @@unique([shopId, orderNumber])
  @@index([shopId])
  @@index([supplierId])
  @@index([shopId, status])
  @@map("purchase_orders")
}

// ── Purchase Order Items ──────────────────────────────────────────────────────

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(10, 2)
  totalCost        Decimal       @db.Decimal(10, 2)

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id])
  receivedItems    GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// ── Goods Receipts (Receiving Records) ────────────────────────────────────────

model GoodsReceipt {
  id              String             @id @default(uuid())
  purchaseOrderId String
  shopId          String
  receivedDate    DateTime           @default(now())
  notes           String?
  createdAt       DateTime           @default(now())

  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([shopId])
  @@map("goods_receipts")
}

// ── Goods Receipt Items ───────────────────────────────────────────────────────

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  quantityReceived    Int

  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
  @@map("goods_receipt_items")
}

// ── Supplier Payments ─────────────────────────────────────────────────────────

model SupplierPayment {
  id              String                @id @default(uuid())
  shopId          String
  supplierId      String
  purchaseOrderId String?
  amount          Decimal               @db.Decimal(10, 2)
  paymentDate     DateTime              @default(now())
  paymentMethod   SupplierPaymentMethod @default(CASH)
  reference       String?
  notes           String?
  createdAt       DateTime              @default(now())

  shop            Shop                  @relation(fields: [shopId], references: [id])
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])

  @@index([shopId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("supplier_payments")
}

